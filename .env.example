# Bot created with @BotFather
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=your_bot_username

# Optional dedicated userbot for authenticated Mini App screenshots.
# Create API credentials at https://my.telegram.org; generate StringSession locally.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USERBOT_SESSION=
# Comma-separated bot usernames authorized for owner-account Mini App authentication.
MINIAPP_ALLOWED_BOTS=

# Optional: comma-separated numeric Telegram user IDs permitted to receive support escalations.
SUPPORT_ADMIN_IDS=

DATABASE_PATH=./data/bot.sqlite3
MAX_UPLOAD_BYTES=15728640
MAX_SCREENSHOT_BYTES=9000000
PAGE_TIMEOUT_SECONDS=25
