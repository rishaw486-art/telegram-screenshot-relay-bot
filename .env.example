# Bot created with @BotFather
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=your_bot_username
# Comma-separated numeric Telegram user IDs with free, unlimited owner access.
OWNER_IDS=

# Remote Turso/libSQL database (required on Render; use your libsql:// URL and auth token).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Render sets PORT and RENDER_EXTERNAL_URL automatically. These defaults enable a best-effort ping every 5 minutes.
SELF_PING_ENABLED=true
SELF_PING_INTERVAL_SECONDS=300

# Dedicated userbot for /send, reply forwarding, and optional authenticated Mini App screenshots.
# Create API credentials at https://my.telegram.org; generate StringSession locally.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USERBOT_SESSION=
# Comma-separated bot usernames authorized for owner-account Mini App authentication.
MINIAPP_ALLOWED_BOTS=

# Optional: comma-separated numeric Telegram user IDs permitted to receive support escalations.
SUPPORT_ADMIN_IDS=

# Groq vision captions; screenshots are sent to Groq when a key is configured.
ENABLE_REMOTE_VISION=true
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

DATABASE_PATH=./data/bot.sqlite3
MAX_UPLOAD_BYTES=15728640
MAX_SCREENSHOT_BYTES=9000000
PAGE_TIMEOUT_SECONDS=25
